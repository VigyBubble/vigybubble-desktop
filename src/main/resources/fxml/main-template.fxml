<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane fx:id="root" prefHeight="1024.0" prefWidth="1440.0" stylesheets="@../css/main-template.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.effortcure.controller.MainTemplateController">
  <children>
    <Pane fx:id="navbarPane" prefHeight="171.0" prefWidth="1440.0" styleClass="navbar-pane">
      <children>
        <Pane fx:id="userCard" layoutX="20.0" layoutY="26.0" prefHeight="119.0" prefWidth="384.0" styleClass="user-card">
          <children>
            <Label fx:id="userNameLabel" layoutX="119.0" layoutY="17.5" prefHeight="51.0" prefWidth="255.0" styleClass="title-font" text="Shahd Ahmed">
              <font>
                <Font size="35.0" />
              </font>
            </Label>
            <TextFlow fx:id="dwsLabel" layoutX="119.0" layoutY="69.0" prefHeight="33.0" prefWidth="241.0">
              <Text fx:id="labelText" styleClass="label-text" text="DWS : ">
                <font>
                  <Font size="24" />
                </font>
              </Text>
              <Text fx:id="valueText" styleClass="value-text" text="10">
                <font>
                  <Font size="24" />
                </font>
              </Text>
            </TextFlow>
            <ImageView fx:id="profileImageView" fitHeight="90" fitWidth="90" layoutX="14.5" layoutY="14.5">
              <clip>
                <Circle fx:id="circleProfile" centerX="45" centerY="45" radius="45" />
              </clip>
              <image>
                <Image url="@../images/mm.png" />
              </image>
            </ImageView>
          </children>
        </Pane>
        <Pane fx:id="rightControlsPane" layoutX="737.0" layoutY="16.0" prefHeight="139.0" prefWidth="687.0" styleClass="navbar-pane">
          <children>
            <Pane fx:id="rightControlsContainer" layoutX="387.0" prefHeight="68.0" prefWidth="300.0">
              <children>
                <Button fx:id="notificationsBtn" layoutX="244.0" layoutY="6.0" mnemonicParsing="false" prefHeight="56.0" prefWidth="56.0" styleClass="settingsBtn">
                  <graphic>
                    <ImageView fx:id="bellIcon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                      <image>
                        <Image url="@../images/notification-icon.png" />
                      </image>
                    </ImageView>
                  </graphic>
                </Button>
                <Button fx:id="settingBtn" layoutX="172.0" layoutY="6.0" prefHeight="56.0" prefWidth="56.0" styleClass="settingsBtn">
                  <graphic>
                    <ImageView fx:id="settingIcon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                      <image>
                        <Image url="@../images/setting-icon.png" />
                      </image>
                    </ImageView>
                  </graphic>
                </Button>
                <Label fx:id="planLabel" alignment="CENTER" prefHeight="68.0" prefWidth="148.0" text="Standard" textFill="WHITE">
                  <font>
                    <Font size="28.0" />
                  </font>
                  <padding>
                    <Insets left="10.0" right="10.0" />
                  </padding>
                  <styleClass>
                    <String fx:value="plan-pane" />
                    <String fx:value="text-font" />
                  </styleClass>
                </Label>
              </children>
            </Pane>
            <Label fx:id="homeBtn" alignment="CENTER" layoutY="100.0" prefHeight="39.0" prefWidth="107.0" style="-fx-background-radius: 15 0 0 15;" text="Home" textFill="WHITE">
              <font>
                <Font size="30.0" />
              </font>
              <styleClass>
                <String fx:value="navTabs" />
                <String fx:value="text-font" />
              </styleClass>
            </Label>
            <Label fx:id="peripheralsBtn" alignment="CENTER" layoutX="107.0" layoutY="100.0" prefHeight="39.0" prefWidth="171.0" text="Periphrals" textFill="WHITE">
              <font>
                <Font size="30.0" />
              </font>
              <styleClass>
                <String fx:value="navTabs" />
                <String fx:value="text-font" />
              </styleClass>
            </Label>
            <Label fx:id="analyticsBtn" alignment="CENTER" layoutX="278.0" layoutY="100.0" prefHeight="39.0" prefWidth="161.0" text="Analytics" textFill="WHITE">
              <font>
                <Font size="30.0" />
              </font>
              <styleClass>
                <String fx:value="navTabs" />
                <String fx:value="text-font" />
              </styleClass>
            </Label>
            <Label fx:id="teamsBtn" alignment="CENTER" layoutX="439.0" layoutY="100.0" prefHeight="39.0" prefWidth="248.0" style="-fx-background-radius: 0 15 15 0;" text="Teams &amp; Groups" textFill="WHITE">
              <font>
                <Font size="30.0" />
              </font>
              <styleClass>
                <String fx:value="navTabs" />
                <String fx:value="text-font" />
              </styleClass>
            </Label>
          </children>
        </Pane>
      </children>
    </Pane>
    <AnchorPane fx:id="anchorPaneBody" layoutY="171.0" prefHeight="853.0" prefWidth="1440.0" />
  </children>
</AnchorPane>

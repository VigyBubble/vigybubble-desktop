<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="1024.0" prefWidth="1440.0" stylesheets="@../css/main-template.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.effortcure.controller.MainTemplateController">
  <children>
    <Pane fx:id="navbarPane" prefHeight="171.0" prefWidth="1440.0" styleClass="navbar-pane">
      <children>
        <Pane fx:id="userCard" layoutX="19.5" layoutY="19.5" prefHeight="132.0" prefWidth="449.0" styleClass="user-card">
          <children>
            <Label fx:id="userNameLabel" layoutX="121.0" layoutY="16.0" prefHeight="40.0" text="Shahd Ahmed">
              <font>
                <Font size="28.0" />
              </font>
            </Label>
            <Label fx:id="dwsLabel" layoutX="121.0" layoutY="68.0" prefHeight="35.0" text="DWS : 0">
              <font>
                <Font size="24.0" />
              </font>
            </Label>
            <Pane fx:id="profileImgContainer" layoutX="24.0" layoutY="29.5" prefHeight="73.0" prefWidth="73.0" styleClass="profileImgContainer">
              <children>
                <ImageView fx:id="profileImg" fitHeight="40.0" fitWidth="40.0" layoutX="17.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                    <Image url="@../images/fluent_person-32-light.png" />
                  </image>
                </ImageView>
              </children>
            </Pane>
          </children>
        </Pane>
        <Pane fx:id="rightControlsContainer" layoutX="1087.0" layoutY="14.0" prefHeight="68.0" prefWidth="336.0">
          <children>
            <Button fx:id="notificationsBtn" layoutX="272.0" layoutY="6.0" mnemonicParsing="false" prefHeight="56.0" prefWidth="56.0" styleClass="settingsBtn">
              <graphic>
                <ImageView fx:id="bellIcon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                    <Image url="@../images/notification-icon.png" />
                  </image>
                </ImageView>
              </graphic>
            </Button>
            <Button fx:id="settingBtn" layoutX="197.0" layoutY="7.0" prefHeight="56.0" prefWidth="56.0" styleClass="settingsBtn">
              <graphic>
                <ImageView fx:id="settingIcon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                    <Image url="@../images/setting-icon.png" />
                  </image>
                </ImageView>
              </graphic>
            </Button>
          <Label fx:id="planLabel" alignment="CENTER" layoutX="14.0" layoutY="4.0" prefHeight="61.0" prefWidth="161.0" styleClass="plan-pane" text="Standard" textFill="WHITE">
            <font>
              <Font size="28.0" />
            </font>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
          </Label>
          </children>
        </Pane>
            <Button fx:id="teamsBtn" layoutX="1248.0" layoutY="123.0" mnemonicParsing="false" prefHeight="5.0" styleClass="navTabs" text="Teams &amp; Groups" textFill="WHITE">
               <font>
                  <Font size="22.0" />
               </font>
            </Button>
            <Button fx:id="analyticsBtn" layoutX="1133.0" layoutY="123.0" mnemonicParsing="false" prefHeight="30.0" styleClass="navTabs" text="Analytics" textFill="WHITE">
               <font>
                  <Font size="22.0" />
               </font>
            </Button>
            <Button fx:id="peripheralsBtn" layoutX="1009.0" layoutY="123.0" mnemonicParsing="false" prefHeight="30.0" styleClass="navTabs" text="Periphrals" textFill="WHITE">
               <font>
                  <Font size="22.0" />
               </font>
            </Button>
            <Button fx:id="homeBtn" layoutX="921.0" layoutY="123.0" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-radius: 15 0 0 15;" styleClass="navTabs" text="Home" textFill="WHITE">
               <font>
                  <Font size="22.0" />
               </font>
            </Button>
      </children>
    </Pane>
    <AnchorPane fx:id="anchorPaneBody" layoutY="171.0" prefHeight="853.0" prefWidth="1440.0" />
  </children>
</AnchorPane>

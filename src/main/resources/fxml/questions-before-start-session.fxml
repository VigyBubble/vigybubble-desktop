<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="1024.0" prefWidth="1440.0" styleClass="main-container" stylesheets="@../css/user-information.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.effortcure.controller.QuestionsBeforeSessionsController">
  <children>
    <Pane fx:id="waterpane" layoutX="40.0" layoutY="145.0" prefHeight="330.0" prefWidth="1158.0" styleClass="field-shadow">
      <children>
        <Label fx:id="drinkquestion" layoutX="24.0" layoutY="88.0" prefHeight="45.0" prefWidth="525.0" styleClass="all-labels" text="How much water do you drink per day?">
          <font>
            <Font size="30.0"/>
          </font>
        </Label>
        <Spinner fx:id="spinner" editable="true" layoutX="24.0" layoutY="176.5" prefHeight="56.0" prefWidth="280.0">
          <styleClass>
            <String fx:value="custom-spinner"/>
            <String fx:value="field-shadow"/>
          </styleClass>
        </Spinner>
        <ComboBox fx:id="mlcombobox" layoutX="319.0" layoutY="177.0" prefHeight="56.0" prefWidth="137.0" promptText="mL" styleClass="custom-combo"/>
        <ImageView fx:id="waterimg" fitHeight="250.0" fitWidth="500.0" layoutX="634.0" layoutY="40.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/bottles.png"/>
          </image>
        </ImageView>
      </children>
    </Pane>
    <Pane fx:id="mealpane" layoutX="40.0" layoutY="507.0" prefHeight="355.0" prefWidth="1312.0" styleClass="field-shadow">
      <children>
        <RadioButton fx:id="radiobtn1" layoutX="32.0" layoutY="131.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="286.0" text="Less than 1.5 hours">
          <styleClass>
            <String fx:value="all-labels"/>
            <String fx:value="custom-radio"/>
          </styleClass>
          <font>
            <Font size="28.0"/>
          </font>
        </RadioButton>
        <Label layoutX="24.0" layoutY="44.0" prefHeight="39.0" prefWidth="594.0" styleClass="all-labels" text="How long has it been since your last meal?">
          <font>
            <Font size="30.0"/>
          </font>
        </Label>
        <RadioButton fx:id="radiobtn2" layoutX="348.0" layoutY="131.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="301.0" text="1.5 to under 3 hours">
          <styleClass>
            <String fx:value="all-labels"/>
            <String fx:value="custom-radio"/>
          </styleClass>
          <font>
            <Font size="28.0"/>
          </font>
        </RadioButton>
        <RadioButton fx:id="radiobtn3" layoutX="32.0" layoutY="199.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="286.0" text="3 to under 5 hours">
          <styleClass>
            <String fx:value="all-labels"/>
            <String fx:value="custom-radio"/>
          </styleClass>
          <font>
            <Font size="28.0"/>
          </font>
        </RadioButton>
        <RadioButton fx:id="radiobtn4" layoutX="348.0" layoutY="199.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="286.0" text="5 to under 7 hours">
          <styleClass>
            <String fx:value="all-labels"/>
            <String fx:value="custom-radio"/>
          </styleClass>
          <font>
            <Font size="28.0"/>
          </font>
        </RadioButton>
        <RadioButton fx:id="radiobtn5" layoutX="32.0" layoutY="267.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="294.0" text="7 to under 12 hours">
          <styleClass>
            <String fx:value="all-labels"/>
            <String fx:value="custom-radio"/>
          </styleClass>
          <font>
            <Font size="28.0"/>
          </font>
        </RadioButton>
        <RadioButton fx:id="radiobtn6" layoutX="348.0" layoutY="267.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="301.0" text="More than 12 hours">
          <styleClass>
            <String fx:value="all-labels"/>
            <String fx:value="custom-radio"/>
          </styleClass>
          <font>
            <Font size="28.0"/>
          </font>
        </RadioButton>
        <ImageView fx:id="mealimg" fitHeight="275.0" fitWidth="550.0" layoutX="738.0" layoutY="40.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/lastmeal.png"/>
          </image>
        </ImageView>
      </children>
    </Pane>
    <Button fx:id="donebtn" layoutX="1058.0" layoutY="908.0" mnemonicParsing="false" onAction="#handleDoneBtn" prefHeight="56.0" prefWidth="294.0" styleClass="next-btn" text="Done">
      <font>
        <Font size="32.0"/>
      </font>
    </Button>
    <Button fx:id="skipbutton" contentDisplay="RIGHT" layoutX="1279.0" layoutY="74.0" mnemonicParsing="false" prefHeight="67.0" prefWidth="125.0" styleClass="skip-btn" text="Skip">
      <font>
        <Font size="30.0"/>
      </font>
      <graphic>
        <ImageView fx:id="skipicon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/skip-icon.png"/>
          </image>
        </ImageView>
      </graphic>
    </Button>
    <Pane fx:id="overlay" prefHeight="1024.0" prefWidth="1440.0" style="-fx-background-color: rgba(0,0,0,0.3);" visible="false"/>
  </children>
</AnchorPane>

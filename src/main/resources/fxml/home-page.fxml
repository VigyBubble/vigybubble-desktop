<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="853.0" prefWidth="1440.0" styleClass="main-container" stylesheets="@../css/home-page.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.effortcure.controller.HomePageController">
  <children>
    <ImageView fx:id="bubbleImg1" fitHeight="139.71" fitWidth="139.7" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="bubbleImg5" fitHeight="139.71" fitWidth="139.7" layoutX="703.0" layoutY="152.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="bubbleImg4" fitHeight="139.71" fitWidth="139.7" layoutX="1284.0" layoutY="360.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="bubbleImg3" fitHeight="139.71" fitWidth="139.7" layoutX="941.0" layoutY="713.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="bubbleImg2" fitHeight="139.71" fitWidth="139.7" layoutX="7.0" layoutY="641.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <Pane fx:id="searchPane" layoutX="100.0" layoutY="80.0" prefHeight="71.0" prefWidth="550.0" styleClass="all-panes">
      <children>
        <Label fx:id="dayLabel" layoutX="16.0" layoutY="16.0" prefHeight="39.0" prefWidth="69.0" styleClass="regular-labels" text="Day">
          <font>
            <Font size="30.0"/>
          </font>
        </Label>
        <Separator fx:id="searchSeparator" layoutX="84.0" layoutY="25.0" orientation="VERTICAL" prefHeight="22.0" prefWidth="1.0"/>
        <TextField fx:id="searchField" layoutX="99.0" layoutY="20.0" prefHeight="37.0" prefWidth="373.0" promptText="Filter by day..." styleClass="search-field">
          <font>
            <Font size="24.0"/>
          </font>
        </TextField>
        <ImageView fx:id="searchIcon" fitHeight="24.0" fitWidth="24.0" layoutX="510.0" layoutY="23.5" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/search-icon.png"/>
          </image>
          <cursor>
            <Cursor fx:constant="HAND"/>
          </cursor>
        </ImageView>
      </children>
    </Pane>
    <Button fx:id="addBtn" layoutX="100.0" layoutY="191.0" mnemonicParsing="false" prefHeight="71.0" prefWidth="1240.0" styleClass="all-panes" text="Add New Bubble">

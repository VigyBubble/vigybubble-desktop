        <Font size="30.0"/>
      </font>
      <graphic>
        <ImageView fx:id="addIcon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/add-icon.png"/>
          </image>
        </ImageView>
      </graphic>
      <cursor>
        <Cursor fx:constant="HAND"/>
      </cursor>
    </Button>
    <ComboBox fx:id="typeComboBox" layoutX="939.0" layoutY="80.0" prefHeight="71.0" prefWidth="401.0" promptText="Type of bubble" styleClass="all-panes" style="-fx-font-size: 30px;">
      <cursor>
        <Cursor fx:constant="HAND"/>
      </cursor>
    </ComboBox>
    <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" layoutX="100.0" layoutY="302.0" prefHeight="451.0" prefWidth="1240.0" styleClass="details-pane" vbarPolicy="ALWAYS">
      <content>
        <VBox fx:id="vboxContainer">

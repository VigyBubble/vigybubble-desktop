<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="853.0" prefWidth="1440.0" styleClass="main-container" stylesheets="@../css/create-bubble.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.effortcure.controller.CreateBubbleController">
  <children>
    <ImageView fx:id="arrowBtn" fitHeight="25.0" fitWidth="24.0" layoutX="40.0" layoutY="40.0" onMouseClicked="#backToHome" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand">
      <image>
        <Image url="@../images/left-arrow.png"/>
      </image>
    </ImageView>
    <Label fx:id="nameLabel" layoutX="100.0" layoutY="95.0" prefHeight="56.0" prefWidth="404.0" styleClass="all-labels" text="Name" textFill="#0b3e3a">
      <font>
        <Font size="30.0"/>
      </font>
    </Label>
    <TextField fx:id="bubbleNameField" layoutX="116.0" layoutY="158.0" prefHeight="56.0" prefWidth="1224.0" promptText="Enter bubble name" style="" styleClass="all-fields">
      <font>
        <Font size="24.0"/>
      </font>
    </TextField>
    <Label fx:id="descriptionLabel" layoutX="100.0" layoutY="238.0" prefHeight="39.0" prefWidth="404.0" styleClass="all-labels" text="Describtion" textFill="#0b3e3a">
      <font>
        <Font size="30.0"/>
      </font>
    </Label>
    <TextArea fx:id="bubbleDescriptionField" layoutX="116.0" layoutY="301.0" prefHeight="143.0" prefWidth="1224.0" promptText="Enter bubble describtion" styleClass="text-area" wrapText="true">
      <font>
        <Font size="24.0"/>
      </font>
    </TextArea>
    <Button fx:id="nextBtn" layoutX="1060.0" layoutY="697.0" mnemonicParsing="false" onAction="#next1" prefHeight="56.0" prefWidth="280.0" style="-fx-cursor: hand;" styleClass="next-btn" text="Next">
      <font>
        <Font size="32.0"/>
      </font>
    </Button>
    <ImageView fx:id="progressImg" fitHeight="150.0" fitWidth="150.0" layoutX="645.0" layoutY="629.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/Circular%20Chart%20-%2033%25.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="bubbleImg" fitHeight="139.71" fitWidth="139.7" layoutX="48.0" layoutY="694.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <Label fx:id="typeLabel" layoutX="100.0" layoutY="468.0" prefHeight="39.0" prefWidth="404.0" styleClass="all-labels" text="Type of bubble" textFill="#0b3e3a">
      <font>
        <Font size="30.0"/>
      </font>
    </Label>
    <ComboBox fx:id="comboBox" layoutX="116.0" layoutY="531.0" prefHeight="56.0" prefWidth="1224.0" promptText="Select type of bubble" style="-fx-font-size: 24px" styleClass="comboType">
      <cursor>
        <Cursor fx:constant="HAND"/>
      </cursor>
    </ComboBox>
  </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>

<Pane fx:id="deviceStatusPane" prefHeight="92.0" prefWidth="1240.0" styleClass="inner-banes" stylesheets="@../css/create-bubble.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="deviceName" alignment="TOP_LEFT" layoutX="92.0" layoutY="28.0" prefHeight="40.0" prefWidth="593.0" text="Name of device">
      <font>
        <Font size="28.0" />
      </font>
    </Label>
    <ImageView fx:id="closeIcon" fitHeight="24.0" fitWidth="24.0" layoutX="1209.0" layoutY="34.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/close-icon.png" />
      </image>
      <cursor>
        <Cursor fx:constant="HAND" />
      </cursor>
    </ImageView>
    <Pane layoutX="16.0" layoutY="16.0" prefHeight="60.0" prefWidth="60.0" styleClass="deviceImg-pane">
      <children>
        <ImageView fx:id="deviceImg" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/sensors%20(5).png" />
          </image>
        </ImageView>
      </children>
    </Pane>
    <Label fx:id="deviceStatusLabel" alignment="CENTER" layoutX="1077.0" layoutY="22.5" prefHeight="47.0" prefWidth="102.0" styleClass="offline-label" text="Offline">
      <font>
        <Font size="24.0" />
      </font>
    </Label>
  </children>
</Pane>

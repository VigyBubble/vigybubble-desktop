<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane fx:id="headerContainer" prefHeight="171.0" prefWidth="1440.0" style="-fx-background-color: #177B75;">

    <children>

        <!-- User Card -->
        <Pane fx:id="userCard" layoutX="16.0" layoutY="19.5" prefHeight="132.0" prefWidth="383.0"
              style="-fx-background-color: white; -fx-background-radius: 20;">

            <children>

                <Label fx:id="userNameLabel" layoutX="121.0" layoutY="16.0"
                       text="Shahd Ahmed">
                    <font><Font size="28.0" /></font>
                </Label>

                <Label fx:id="dwsLabel" layoutX="121.0" layoutY="68.0"
                       text="DWS : 0">
                    <font><Font size="24.0" /></font>
                </Label>

                <!-- Profile Icon -->
                <Pane fx:id="profileIconContainer" layoutX="24.0" layoutY="29.5"
                      prefHeight="73.0" prefWidth="73.0"
                      style="-fx-background-radius: 50; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(13, 92, 92, 0.38), 10, 0, 0, 4);">

                    <children>
                        <ImageView fx:id="profileIcon" fitHeight="40.0" fitWidth="40.0"
                                   layoutX="17.0" layoutY="16.0">
                            <image>
                                <Image url="@../images/fluent_person-32-light.png" />
                            </image>
                        </ImageView>
                    </children>

                </Pane>

            </children>
        </Pane>

        <!-- Right Section -->
        <Pane fx:id="rightControlsContainer" layoutX="1124.0" layoutY="16.0"
              prefHeight="68.0" prefWidth="300.0">

            <children>

                <!-- Plan -->
                <Pane fx:id="planBadge" prefHeight="68.0" prefWidth="148.0"
                      style="-fx-background-color: #22B9AF; -fx-background-radius: 30; -fx-effect: dropshadow(gaussian, rgba(13, 92, 92, 0.38), 10, 0, 0, 4);">

                    <children>
                        <Label fx:id="planLabel" layoutX="16.0" layoutY="16.0"
                               text="Standard" textFill="WHITE">
                            <font><Font size="28.0" /></font>
                        </Label>
                    </children>

                </Pane>

                <!-- Settings -->
                <Pane fx:id="settingsButton" layoutX="160.0" layoutY="6.0"
                      prefHeight="56.0" prefWidth="56.0"
                      style="-fx-background-color: #177B75; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(13, 92, 92, 0.38), 10, 0, 0, 4); -fx-cursor: hand;">

                    <children>
                        <ImageView fx:id="settingsIcon" fitHeight="24.0" fitWidth="24.0"
                                   layoutX="16.0" layoutY="16.0">
                            <image>
                                <Image url="@../images/setting-icon.png" />
                            </image>
                        </ImageView>
                    </children>

                </Pane>

                <!-- Notifications -->
                <Pane fx:id="notificationButton" layoutX="235.0" layoutY="6.0"
                      prefHeight="56.0" prefWidth="56.0"
                      style="-fx-background-color: #177B75; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(13, 92, 92, 0.38), 10, 0, 0, 4); -fx-cursor: hand;">

                    <children>
                        <ImageView fx:id="notificationIcon" fitHeight="24.0" fitWidth="24.0"
                                   layoutX="16.0" layoutY="16.0">
                            <image>
                                <Image url="@../images/bell-icon.png" />
                            </image>
                        </ImageView>
                    </children>

                </Pane>

            </children>
        </Pane>

        <!-- Navigation Bar -->
        <Pane fx:id="navBar" layoutX="737.0" layoutY="113.0"
              prefHeight="39.0" prefWidth="687.0"
              style="-fx-background-color: #177B75;">

            <children>

                <!-- Home -->
                <Pane fx:id="homeTab" prefWidth="107.0"
                      style="-fx-background-radius: 15 0 0 15; -fx-cursor: hand;">

                    <children>
                        <Hyperlink fx:id="homeLink" text="Home" textFill="WHITE"
                                   prefWidth="107.0" alignment="CENTER"/>
                    </children>

                </Pane>

                <!-- Peripherals -->
                <Pane fx:id="peripheralsTab" layoutX="107.0" prefWidth="171.0"
                      style="-fx-cursor: hand;">

                    <children>
                        <Hyperlink fx:id="peripheralsLink" text="Periphrals" textFill="WHITE"
                                   prefWidth="171.0" alignment="CENTER"/>
                    </children>

                </Pane>

                <!-- Analytics -->
                <Pane fx:id="analyticsTab" layoutX="278.0" prefWidth="161.0"
                      style="-fx-cursor: hand;">

                    <children>
                        <Hyperlink fx:id="analyticsLink" text="Analytics" textFill="WHITE"
                                   prefWidth="161.0" alignment="CENTER"/>
                    </children>

                </Pane>

                <!-- Teams -->
                <Pane fx:id="teamsTab" layoutX="439.0" prefWidth="248.0"
                      style="-fx-background-radius: 0 15 15 0; -fx-cursor: hand;">

                    <children>
                        <Hyperlink fx:id="teamsLink" text="Teams &amp; Groups" textFill="WHITE"
                                   prefWidth="248.0" alignment="CENTER"/>
                    </children>

                </Pane>

            </children>
        </Pane>

    </children>
</Pane>

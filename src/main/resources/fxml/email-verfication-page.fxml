<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<AnchorPane prefWidth="1000" prefHeight="680" stylesheets="@../css/verification-page.css"
   xmlns="http://javafx.com/javafx/21"
   xmlns:fx="http://javafx.com/fxml/1">

   <children>

      <!-- CARD centered -->
      <StackPane styleClass="card" prefWidth="700" prefHeight="600" AnchorPane.topAnchor="90" AnchorPane.leftAnchor="150" AnchorPane.rightAnchor="150">
    <!-- Back Button -->
            <HBox alignment="TOP_LEFT">
               <Button text="←" styleClass="back-btn"/>
            </HBox>

         <VBox alignment="TOP_CENTER" spacing="15" prefWidth="600" maxWidth="600">

        
            <!-- Logo -->
            <StackPane prefWidth="180" prefHeight="180" styleClass="logo"/>

            <!-- Title -->
            <Label text="Enter verification code" styleClass="title-label"/>

            <!-- Subtitle -->
            <Label text="A verification code has been sent to your email." wrapText="true" alignment="CENTER" styleClass="subtitle-label"/>

            <!-- OTP -->
            <HBox spacing="20" alignment="CENTER">
               <TextField styleClass="otp-field"/>
               <TextField styleClass="otp-field"/>
               <TextField styleClass="otp-field"/>
               <TextField styleClass="otp-field"/>
            </HBox>

            <!-- Resend -->
            <HBox alignment="CENTER" spacing="4">
               <Label text="Don't get code?" styleClass="resend-label"/>
               <Hyperlink text="Click to resend" styleClass="resend-link"/>
            </HBox>

            <Separator prefWidth="500"/>

            <!-- Buttons -->
            <HBox spacing="20" alignment="CENTER">
               <Button text="Cancel" styleClass="cancel-btn"/>
               <Button text="Verify" styleClass="verify-btn"/>
            </HBox>

         </VBox>
      </StackPane>

   </children>
</AnchorPane>

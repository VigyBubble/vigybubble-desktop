<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane stylesheets="@../css/verification-page.css"
   xmlns="http://javafx.com/javafx/21"
   xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER">

   <children>

      <!-- CARD centered -->
      <StackPane styleClass="card" alignment="CENTER">
         <!-- Back Button -->
         <HBox alignment="TOP_LEFT">
            <Button text="←" styleClass="back-btn"/>
         </HBox>

         <VBox alignment="TOP_CENTER" spacing="15">


            <!-- Logo -->
            <StackPane prefWidth="180" prefHeight="180" styleClass="logo"/>

            <!-- Title -->
            <Label text="Enter verification code" styleClass="title-label"/>

            <!-- Subtitle -->
            <Label text="A verification code has been sent to your email." wrapText="true" alignment="CENTER" styleClass="subtitle-label"/>

            <!-- OTP -->
            <HBox spacing="20" alignment="CENTER">
               <TextField styleClass="otp-field" fx:id="otpField1"/>
               <TextField styleClass="otp-field" fx:id="otpField2"/>
               <TextField styleClass="otp-field" fx:id="otpField3"/>
               <TextField styleClass="otp-field" fx:id="otpField4"/>
            </HBox>

            <!-- Resend -->
            <HBox alignment="CENTER" spacing="4">
               <Label text="Don't get code?" styleClass="resend-label"/>
               <Hyperlink text="Click to resend" styleClass="resend-link"/>
            </HBox>

            <Separator prefWidth="0"/>

            <!-- Buttons -->
            <HBox spacing="20" alignment="CENTER" styleClass="btn-container">
               <Button text="Cancel" styleClass="cancel-btn" fx:id="cancelBtn"/>
               <Button text="Verify" styleClass="verify-btn" fx:id="verifyBtn"/>
            </HBox>

         </VBox>
      </StackPane>

   </children>
</StackPane>

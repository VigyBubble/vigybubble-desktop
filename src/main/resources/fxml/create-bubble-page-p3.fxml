<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root3" prefHeight="853.0" prefWidth="1440.0" styleClass="main-container" stylesheets="@../css/create-bubble.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.effortcure.controller.CreateBubbleController">
  <children>
    <ImageView fx:id="arrowBtn3" fitHeight="25.0" fitWidth="24.0" layoutX="40.0" layoutY="40.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#backToCB2" style="-fx-cursor: hand">
      <image>
        <Image url="@../images/left-arrow.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="progressImg3" fitHeight="150.0" fitWidth="150.0" layoutX="645.0" layoutY="629.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/Circular%20Chart%20-%20100%25.png"/>
      </image>
    </ImageView>
    <Button fx:id="saveBtn" onAction="#save" layoutX="1060.0" layoutY="697.0" mnemonicParsing="false" prefHeight="56.0" prefWidth="280.0" styleClass="next-btn" text="Save">
      <font>
        <Font size="32.0"/>
      </font>
      <cursor>
        <Cursor fx:constant="HAND"/>
      </cursor>
    </Button>
    <ImageView fx:id="bubbleImg11" fitHeight="159.0" fitWidth="159.0" layoutX="56.0" layoutY="562.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="bubbleImg3" fitHeight="159.0" fitWidth="159.0" layoutX="413.0" layoutY="585.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <ImageView fx:id="bubbleImg22" fitHeight="159.0" fitWidth="159.0" layoutX="230.0" layoutY="678.0" pickOnBounds="true" preserveRatio="true">
      <image>
        <Image url="@../images/bubble.png"/>
      </image>
    </ImageView>
    <Pane fx:id="enterUrlPane" layoutX="100.0" layoutY="108.0" prefHeight="79.0" prefWidth="746.0" styleClass="url-pane">
      <children>
        <TextField fx:id="urlField" layoutX="56.0" layoutY="19.0" prefHeight="37.0" prefWidth="583.0" promptText="Enter URL">
          <font>
            <Font size="24.0"/>
          </font>
          <styleClass>
            <String fx:value="search-field"/>
            <String fx:value="prompt-text"/>
          </styleClass>
        </TextField>
        <Button fx:id="addBtn2" onAction="#addDirectory" layoutX="656.0" layoutY="16.0" mnemonicParsing="false" prefHeight="47.0" prefWidth="74.0" styleClass="add-button" text="Add">
          <font>
            <Font size="20.0"/>
          </font>
          <cursor>
            <Cursor fx:constant="HAND"/>
          </cursor>
        </Button>
        <ImageView fx:id="urlIcon" fitHeight="24.0" fitWidth="24.0" layoutX="16.0" layoutY="27.5" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/url2-icon.png"/>
          </image>
        </ImageView>
      </children>
    </Pane>
    <Button fx:id="selectFolderBtn" alignment="CENTER" layoutX="881.0" layoutY="108.0" mnemonicParsing="false" prefHeight="79.0" prefWidth="234.0" styleClass="add-button" text="Select folder" textFill="WHITE">
      <font>
        <Font size="28.0"/>
      </font>
      <graphic>
        <ImageView fx:id="addFolderIcon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/select-icon.png"/>
          </image>
        </ImageView>
      </graphic>
      <cursor>
        <Cursor fx:constant="HAND"/>
      </cursor>
    </Button>
    <Button fx:id="selectFileBtn" alignment="CENTER" layoutX="1139.0" layoutY="108.0" mnemonicParsing="false" prefHeight="79.0" prefWidth="201.0" styleClass="add-button" text="Select file" textFill="WHITE">
      <font>
        <Font size="28.0"/>
      </font>
      <graphic>
        <ImageView fx:id="addFileIcon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url="@../images/select-icon.png"/>
          </image>
        </ImageView>
      </graphic>
      <cursor>
        <Cursor fx:constant="HAND"/>
      </cursor>
    </Button>
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" layoutX="100.0" layoutY="219.0" prefHeight="354.0" prefWidth="1260.0" styleClass="url-pane" vbarPolicy="ALWAYS">
      <content>
        <VBox fx:id="resourcesContainer" spacing="0"/>
      </content>
    </ScrollPane>
  </children>
</AnchorPane>
